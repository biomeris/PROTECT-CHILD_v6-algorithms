          "description": "beta or m_value",
          "is_frontend_only": false,
          "has_default_value": true,
          "default_value": "beta"
        },
        {
          "name": "min_samples",
          "type": "integer",
          "display_name": "Minimum samples (privacy)",
          "description": "Minimum samples a hospital, and a cohort at a hospital, needs before any summary of it is returned (at least 2)",
          "is_frontend_only": false,
