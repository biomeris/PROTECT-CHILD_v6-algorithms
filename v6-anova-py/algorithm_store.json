{
  "name": "v6-anova-py",
  "image": "ghcr.io/biomeris/v6-anova-py",
  "vantage6_version": "5.0",
  "code_url": "https://github.com/AndrewCesc/PROTECT-CHILD_v6-algorithms/tree/anova-andrea-v5/v6-anova-py",
  "documentation_url": "",
  "partitioning": "horizontal",
  "functions": [
    {
      "name": "central_function",
      "description": "Federated one-way ANOVA using per-group count/sum/sum_sq",
      "step_type": "central_compute",
      "arguments": [
        {
          "name": "group_col",
          "type": "str",
          "description": "Grouping column name"
        },
        {
          "name": "features",
          "type": "list[str]",
          "description": "Numeric features or null for all"
        },
        {
          "name": "organizations_to_include",
          "type": "list[int]",
          "description": "Optional organization IDs"
        }
      ]
    },
    {
      "name": "federated_function",
      "description": "Return local group sufficient statistics",
      "step_type": "federated_compute",
      "databases": [
        {
          "name": "Database 1"
        }
      ],
      "arguments": [
        {
          "name": "group_col",
          "type": "str",
          "description": "Grouping column"
        },
        {
          "name": "features",
          "type": "list[str]",
          "description": "Numeric features or null"
        }
      ]
    }
  ]
}
