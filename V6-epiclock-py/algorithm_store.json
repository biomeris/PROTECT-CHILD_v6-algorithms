        {
          "name": "cohort_column",
          "type": "column",
          "display_name": "Cohort column",
          "description": "Name of the column in each node's data that holds the cohort of each sample. Results are computed per cohort.",
          "default_value": "cohort",
          "has_default_value": true,
          "is_frontend_only": false
        },
        {
          "name": "min_samples",
          "type": "integer",
          "display_name": "Minimum samples per cohort",
          "description": "Minimum number of samples a cohort needs on a node to be included in that node's result (at least 2). Cohorts below this threshold are dropped on the node.",
          "default_value": 3,
          "has_default_value": true,
          "is_frontend_only": false
        },
        {
          "name": "coverage_threshold",
          "type": "float",
          "display_name": "Coverage threshold",
          "description": "Minimum coverage (share of a clock's CpGs present in a node's data, 0-1) for a result to be flagged coverage_ok. EPIC v2 lacks some clock CpGs and pyaging fills them with reference values or 0, which can bias the age. It only sets the flag; no clock or result is removed.",
          "default_value": 0.9,
          "has_default_value": true,
          "is_frontend_only": false
        },
        {
          "name": "age_column",
          "type": "column",
          "display_name": "Age column",
          "description": "Column with the chronological age of each sample (e.g. 'age' from the IDAT extraction). Used to report the age acceleration, predicted minus chronological age; leave empty to skip.",
          "default_value": "age",
          "has_default_value": true,
          "is_frontend_only": false
        },
        {
          "name": "organizations_to_include",
          "type": "organization_list",
          "display_name": "Hospitals",
          "description": "Hospitals (organizations) to use; empty = all of the collaboration",
          "is_frontend_only": false,
          "has_default_value": true,
          "default_value": null
        }
      ],
      "ui_visualizations": [
        {
          "name": "Epigenetic age per cohort",
          "description": "Mean predicted age, chronological age and age acceleration per clock and cohort",
          "type": "table",
          "schema": {
            "location": [
              "results"
            ],
            "columns": [
              "cohort",
              "clock",
              "mean_age_global",
              "sd_age_global",
              "mean_chronological_age_global",
              "mean_age_acceleration_global",
              "n_samples_total",
              "n_nodes",
              "coverage_ok"
            ]
          }
        },
        {
          "name": "Clock coverage",
          "description": "Share of each clock's CpGs present in the data",
          "type": "table",
          "schema": {
            "location": [
              "clock_coverage"
            ],
            "columns": [
              "clock",
              "coverage_min",
              "coverage_max",
              "n_nodes_reported",
              "n_nodes_coverage_ok",
              "tissue",
              "population"
            ]
          }
        }
      ],
      "standalone": true,
      "display_name": "Epigenetic age per cohort"
    },
